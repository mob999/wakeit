{
  "manifest_version": 1,
  "name": "@wakeit/agents",
  "version": "0.2.1",
  "wakeit": {
    "protocol": 1,
    "commands": {
      "adapter": "plugins/official/bin/wakeit-agent-runtime"
    },
    "artifact": {
      "url": "https://github.com/mob999/wakeit/releases/download/cli-v{version}/wakeit-agents-{target}.tar.gz",
      "checksums_url": "https://github.com/mob999/wakeit/releases/download/cli-v{version}/SHA256SUMS"
    },
    "plugins": {
      "official": {
        "name": "Official Agents",
        "command": "./plugins/official/bin/wakeit-agent-runtime",
        "args": [
          "sdk"
        ],
        "agents": {
          "agy": {
            "name": "Antigravity CLI",
            "logo": "/agent-logos/agy.svg",
            "parameters": {
              "model": {
                "type": "string",
                "label": "模型"
              },
              "reasoning": {
                "type": "string",
                "label": "推理强度"
              }
            },
            "mode": "sync",
            "operations": [
              "detect",
              "execute",
              "models",
              "reconcile"
            ]
          },
