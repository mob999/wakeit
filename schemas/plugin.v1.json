{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "input": {
          "default": {
            "properties": {},
            "type": "object"
          }
        },
        "label": {
          "type": "string"
        },
        "output": {
          "default": null
        },
        "permission": {
          "default": "",
          "type": "string"
        },
        "side_effects": {
          "default": false,
          "type": "boolean"
        },
        "timeout_seconds": {
          "default": 60,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "AgentDescriptor": {
      "additionalProperties": false,
      "properties": {
        "logo": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "name": {
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/AgentOperation"
          },
          "type": "array",
          "uniqueItems": true
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "name",
        "mode",
        "operations"
      ],
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "sync",
        "async"
      ],
      "type": "string"
    },
    "AgentOperation": {
      "description": "A declared operation must have an implementation registered during initialization.",
      "enum": [
        "detect",
        "execute",
        "submit",
        "poll",
        "cancel",
        "reconcile",
        "models",
        "session_list",
        "session_inspect",
        "session_resume",
        "session_rename",
        "session_interactive"
      ],
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "checksums_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "CredentialSlot": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          },
          "default": {},
          "type": "object"
        },
        "agents": {
          "additionalProperties": {
            "$ref": "#/$defs/AgentDescriptor"
          },
          "description": "Static Agent capabilities implemented by this same plugin entry point.",
          "type": "object"
        },
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "type": "string"
        },
        "config": {
          "default": {
            "properties": {},
            "type": "object"
          }
        },
        "credentials": {
          "additionalProperties": {
            "$ref": "#/$defs/CredentialSlot"
          },
          "default": {},
          "type": "object"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "events": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "handlers": {
          "additionalProperties": {
            "$ref": "#/$defs/Handler"
          },
          "default": {},
          "type": "object"
        },
        "hooks": {
          "additionalProperties": {
            "$ref": "#/$defs/Hook"
          },
          "default": {},
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "permissions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "providers": {
          "additionalProperties": {
            "$ref": "#/$defs/Provider"
          },
          "default": {},
          "type": "object"
        },
        "sdk_protocol": {
          "default": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "translations": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "command",
        "name"
      ],
      "type": "object"
    },
    "Handler": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeout_seconds": {
          "default": 60,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "events"
      ],
      "type": "object"
    },
    "Hook": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stage"
      ],
      "type": "object"
    },
    "ParameterSpec": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "enum": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "string",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Provider": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "default": null
        },
        "kind": {
          "type": "string"
        },
        "output": {
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Agent IDs are declared here; package YAML need not repeat them.",
          "type": "object"
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/Artifact"
          },
          "type": "object"
        },
        "commands": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/Extension"
          },
          "type": "object"
        },
        "plugins": {
          "additionalProperties": {
            "$ref": "#/$defs/Extension"
          },
          "description": "Canonical plugin entry points and statically declared capabilities.",
          "type": "object"
        },
        "protocol": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "runtimes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "protocol"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "wakeit": {
      "$ref": "#/$defs/Resources"
    }
  },
  "required": [
    "manifest_version",
    "name",
    "version",
    "wakeit"
  ],
  "title": "Manifest",
  "type": "object"
}
