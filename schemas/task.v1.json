{
  "$defs": {
    "Dag": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        },
        "results": {
          "description": "Absent means the leaves of the current definition, rather than a cached list.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "nodes"
      ],
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "misfire": {
          "$ref": "#/$defs/Misfire",
          "default": "latest"
        },
        "overlap": {
          "$ref": "#/$defs/Overlap",
          "default": "skip"
        },
        "start_grace": {
          "default": "1h",
          "type": "string"
        },
        "timeout": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Misfire": {
      "enum": [
        "skip",
        "latest"
      ],
      "type": "string"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "max_retries": {
          "format": "uint32",
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "pre": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prompt": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "default": "1h",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "runner",
        "agent",
        "cwd",
        "prompt"
      ],
      "type": "object"
    },
    "Overlap": {
      "enum": [
        "skip",
        "allow"
      ],
      "type": "string"
    },
    "Schedule": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "cron": {
          "type": [
            "string",
            "null"
          ]
        },
        "every": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "SessionBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "agent": {
          "minLength": 1
        },
        "cwd": {
          "minLength": 1
        },
        "dag": {
          "type": "null"
        },
        "prompt": {
          "minLength": 1
        },
        "runner": {
          "minLength": 1
        }
      },
      "required": [
        "runner",
        "agent",
        "cwd",
        "prompt"
      ]
    },
    {
      "properties": {
        "agent": {
          "maxLength": 0
        },
        "cwd": {
          "maxLength": 0
        },
        "dag": {
          "type": "object"
        },
        "parameters": {
          "maxProperties": 0
        },
        "prompt": {
          "maxLength": 0
        },
        "runner": {
          "maxLength": 0
        },
        "session": {
          "type": "null"
        }
      },
      "required": [
        "dag"
      ]
    }
  ],
  "properties": {
    "agent": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "dag": {
      "anyOf": [
        {
          "$ref": "#/$defs/Dag"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "execution": {
      "$ref": "#/$defs/Execution",
      "default": {
        "misfire": "latest",
        "overlap": "skip",
        "start_grace": "1h",
        "timeout": null
      }
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "prompt": {
      "type": "string"
    },
    "runner": {
      "type": "string"
    },
    "schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/Schedule"
        },
        {
          "type": "null"
        }
      ]
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "default": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "TaskConfig",
  "type": "object"
}
